{
  "name": "aggrid",
  "widgetName": "AGGrid",
  "version": "1.3.0",
  "description": "AG Grid integration for Mendix",
  "license": "Apache-2.0",
  "author": "Your Name",
  "config": {
    "projectPath": "../MendixProject/",
    "mendixHost": "http://localhost:8080",
    "developmentPort": 3000
  },
  "packagePath": "mendix",
  "engines": {
    "node": ">=22.20.0 <23.0.0-0"
  },
  "scripts": {
    "predev": "node scripts/update-ag-version.js && node scripts/stamp-build-date.js",
    "start": "pluggable-widgets-tools start:server",
    "dev": "pluggable-widgets-tools start:web",
    "prebuild": "node scripts/update-ag-version.js && node scripts/stamp-build-date.js",
    "build": "pluggable-widgets-tools build:web",
    "prerelease": "node scripts/update-ag-version.js && node scripts/stamp-build-date.js",
    "release": "pluggable-widgets-tools release:web && node scripts/strip-console-logs.js",
    "format": "pluggable-widgets-tools format",
    "lint": "pluggable-widgets-tools lint",
    "test": "jest --config jest.config.js --coverage --watchAll=false",
    "test:coverage": "jest --config jest.config.js --coverage --coverageReporters=text-summary --coverageReporters=cobertura --coverageReporters=lcov --watchAll=false"
  },
  "devDependencies": {
    "@mendix/pluggable-widgets-tools": "^10.24.0",
    "@types/archiver": "^7.0.0",
    "@types/pdfmake": "^0.2.12",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "baseline-browser-mapping": "^2.9.19",
    "terser": "^5.44.1"
  },
  "dependencies": {
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "classnames": "^2.5.1",
    "pdfmake": "^0.2.20"
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "@types/react": "18.2.0",
      "@types/react-dom": "18.2.0"
    }
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0"
  },
  "resolutions": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0"
  }
}
