<?xml version="1.0" encoding="utf-8"?>
<widget id="mendix.aggrid.AGGrid" pluginWidget="true" needsEntityContext="true" offlineCapable="false"
        supportedPlatform="Web"
        xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>AG Grid</name>
    <description>Advanced data grid using AG Grid</description>
    <icon/>
    <properties>
        <propertyGroup caption="Data Source">
            <property key="dataSource" type="datasource" isList="true" required="true">
                <caption>Data source</caption>
                <description>The data source for the grid</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Columns">
            <property key="columns" type="object" isList="true" required="true">
                <caption>Columns</caption>
                <description>Define the columns to display</description>
                <properties>
                    <propertyGroup caption="Column">
                        <property key="header" type="textTemplate" required="true">
                            <caption>Header</caption>
                            <description>Column header text</description>
                        </property>
                        <property key="attribute" type="attribute" dataSource="dataSource" required="true">
                            <caption>Attribute</caption>
                            <description>Attribute to display</description>
                            <attributeTypes>
                                <attributeType name="String"/>
                                <attributeType name="Integer"/>
                                <attributeType name="Long"/>
                                <attributeType name="Decimal"/>
                                <attributeType name="Boolean"/>
                                <attributeType name="DateTime"/>
                                <attributeType name="Enum"/>
                            </attributeTypes>
                        </property>
                        <property key="dataType" type="enumeration" defaultValue="auto">
                            <caption>Data Type</caption>
                            <description>Override how the grid interprets this column for sorting, filtering, and formatting. Auto uses the Mendix attribute type.</description>
                            <enumerationValues>
                                <enumerationValue key="auto">Auto (infer from attribute)</enumerationValue>
                                <enumerationValue key="boolean">Boolean</enumerationValue>
                                <enumerationValue key="date">Date</enumerationValue>
                                <enumerationValue key="number">Number</enumerationValue>
                                <enumerationValue key="string">String</enumerationValue>
                            </enumerationValues>
                        </property>
                        <property key="width" type="integer" defaultValue="150">
                            <caption>Width</caption>
                            <description>Column width in pixels</description>
                        </property>
                        <property key="sortable" type="boolean" defaultValue="true">
                            <caption>Sortable</caption>
                            <description>Enable sorting for this column</description>
                        </property>
                        <property key="filter" type="boolean" defaultValue="true">
                            <caption>Filter</caption>
                            <description>Enable filtering for this column</description>
                        </property>
                        <property key="useDateRange" type="boolean" defaultValue="false">
                            <caption>Use Date Range Picker</caption>
                            <description>Show start and end date inputs in the filter drawer instead of a list of values. Only applies to date attributes.</description>
                        </property>
                        <property key="useRelativeRange" type="boolean" defaultValue="false">
                            <caption>Use Relative Date Range</caption>
                            <description>Show a dropdown of relative ranges (last 7 days, last 30 days, etc.) in the filter drawer. Only applies to date attributes.</description>
                        </property>
                        <property key="floatingFilter" type="boolean" defaultValue="false">
                            <caption>Floating Filter</caption>
                            <description>Show the filter below the column header.</description>
                        </property>
                        <property key="resizable" type="boolean" defaultValue="true">
                            <caption>Resizable</caption>
                            <description>Enable column resizing</description>
                        </property>
                        <property key="pinned" type="enumeration" defaultValue="none">
                            <caption>Pinned Position</caption>
                            <description>Pin this column to the left or right side of the grid header.</description>
                            <enumerationValues>
                                <enumerationValue key="none">Not pinned</enumerationValue>
                                <enumerationValue key="left">Left</enumerationValue>
                                <enumerationValue key="right">Right</enumerationValue>
                            </enumerationValues>
                        </property>
                        <property key="pinnable" type="boolean" defaultValue="false">
                            <caption>Allow Pinning in Grid Menu</caption>
                            <description>Allow end users to pin or unpin this column through the column options menu.</description>
                        </property>
                    </propertyGroup>
                </properties>
            </property>
        </propertyGroup>
        <propertyGroup caption="UI Elements">
            <property key="enableSideBar" type="boolean" defaultValue="false">
                <caption>Enable Side Bar</caption>
                <description>Show the AG Grid side bar so users can access column and filter panels.</description>
            </property>
            <property key="enableStatusBar" type="boolean" defaultValue="false">
                <caption>Enable Status Bar</caption>
                <description>Show the AG Grid status bar with row counts and selection information.</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Grid Options">
            <property key="licenseKey" type="string" required="true">
                <caption>AG Grid Enterprise License Key</caption>
                <description>AG Grid Enterprise license key for full functionality</description>
            </property>
            <property key="enableContextMenu" type="boolean" defaultValue="false">
                <caption>Enable Context Menu</caption>
                <description>Show the AG Grid right-click context menu for columns and cells. Disable to prevent context menu access.</description>
            </property>
            <property key="pagination" type="boolean" defaultValue="true">
                <caption>Enable Pagination</caption>
                <description>Enable pagination for the grid</description>
            </property>
            <property key="pageSize" type="integer" defaultValue="20">
                <caption>Page Size</caption>
                <description>Number of rows per page</description>
            </property>
            <property key="height" type="integer" defaultValue="500">
                <caption>Height</caption>
                <description>Grid height in pixels</description>
            </property>
            <property key="theme" type="enumeration" defaultValue="alpine">
                <caption>Theme</caption>
                <description>AG Grid theme</description>
                <enumerationValues>
                    <enumerationValue key="alpine">Alpine</enumerationValue>
                    <enumerationValue key="balham">Balham</enumerationValue>
                    <enumerationValue key="material">Material</enumerationValue>
                    <enumerationValue key="quartz">Quartz</enumerationValue>
                </enumerationValues>
            </property>
            <property key="themeVariant" type="enumeration" defaultValue="auto">
                <caption>Theme Variant</caption>
                <description>Choose the light or dark variant of the selected theme. Auto follows the user’s system preference.</description>
                <enumerationValues>
                    <enumerationValue key="auto">Auto (match system)</enumerationValue>
                    <enumerationValue key="light">Light</enumerationValue>
                    <enumerationValue key="dark">Dark</enumerationValue>
                </enumerationValues>
            </property>
            <property key="enablePolling" type="boolean" defaultValue="false">
                <caption>Enable Data Polling</caption>
                <description>Automatically check for new data added by other users</description>
            </property>
            <property key="pollingInterval" type="integer" defaultValue="60">
                <caption>Polling Interval (seconds)</caption>
                <description>How often to check for new data (in seconds). Minimum 10 seconds.</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Events">
            <property key="onRowClick" type="action" dataSource="dataSource">
                <caption>On Row Click</caption>
                <description>Action to execute when a row is clicked</description>
            </property>
        </propertyGroup>
    </properties>
</widget>
